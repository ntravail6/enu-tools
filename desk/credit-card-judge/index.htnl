<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="8つの質問に答えるだけで、あなたに合いそうなクレジットカードの“タイプ”を診断する参考コンテンツです。5タイプのバランスをチャートで表示します。">
<title>クレカ診断</title>

<!-- iOS / PWA メタ（アイコン・色は 003 準拠で JS が --bg から動的設定） -->
<meta name="theme-color" content="#fcf9ee">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="クレカ診断">
<link rel="apple-touch-icon" id="appleTouchIcon" href="">

<!-- フォント（enu 4種セット） -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Kosugi+Maru&display=swap" rel="stylesheet">

<style>
  /* ===== カラーパレット：09 くすみイエロー（マスタード） ===== */
  :root{
    --primary:        #C4A85A;
    --primary-light:  #ECDDA8;
    --primary-dark:   #9A8238;
    --primary-soft:   #F5EED5;
    --accent:         #B89A4D;
    --bg:             #fcf9ee;
    --bg-soft:        #fefcf6;
    --line:           #ede5cc;
    --card:           #fff;
    --text:           #2C2A24;
    --sub:            #7A756B;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  html,body{ height:100%; }
  body{
    font-family:'Quicksand','Arial Rounded MT Bold','Kosugi Maru',sans-serif;
    color:var(--text);
    background:var(--bg);
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    padding:
      max(16px, env(safe-area-inset-top))
      max(16px, env(safe-area-inset-right))
      max(24px, env(safe-area-inset-bottom))
      max(16px, env(safe-area-inset-left));
  }

  .wrap{
    width:100%;
    max-width:720px;
    margin:0 auto;
    display:flex;
    flex-direction:column;
    min-height:100%;
  }

  /* ===== ヘッダー（診断・結果画面で表示） ===== */
  .app-header{ text-align:center; padding:18px 0 6px; }
  .app-header .badge{
    display:inline-block; font-size:0.72rem; font-weight:600; letter-spacing:.08em;
    color:var(--primary-dark); background:var(--primary-soft);
    border-radius:999px; padding:4px 14px; margin-bottom:10px;
  }
  .app-header h1{ color:var(--primary-dark); font-size:1.5rem; font-weight:700; letter-spacing:.02em; }

  /* ===== ウェルカム共通シェル ===== */
  .welcome-screen{ text-align:center; padding-top:8px; }
  .welcome-icon{
    width:88px; height:88px; border-radius:50%;
    background:linear-gradient(135deg, var(--primary-light), var(--primary));
    display:flex; align-items:center; justify-content:center;
    font-size:42px; line-height:1; margin:8px auto 16px;
    box-shadow:0 6px 18px rgba(154,130,56,.28);
  }
  .welcome-icon .wi-emoji{ display:block; transform:translateY(2px); }
  .welcome-title{ font-size:1.75rem; font-weight:700; color:var(--primary-dark); letter-spacing:.02em; }
  .welcome-tagline{ font-size:0.95rem; color:var(--sub); margin-top:8px; }
  .welcome-card{
    max-width:440px; margin:20px auto 0;
    background:var(--card); border:1px solid var(--line);
    border-radius:14px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.04); text-align:left;
  }
  .welcome-card h3{ font-size:0.95rem; color:var(--primary-dark); margin-bottom:12px; text-align:center; }
  .welcome-features{ list-style:none; display:flex; flex-direction:column; gap:10px; }
  .welcome-features li{
    display:flex; gap:10px; align-items:flex-start; font-size:0.88rem;
    background:var(--bg-soft); border:1px solid var(--line); border-radius:10px; padding:11px 13px;
  }
  .welcome-features li .fi{ flex:0 0 auto; }
  .welcome-actions{ max-width:440px; margin:0 auto; }

  /* === Notice（101 正規仕様） === */
  .enu-notice-area{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 4px}
  .enu-notice-wrap{width:100%}
  .enu-notice-wrap.is-mini{width:auto}
  .enu-notice-wrap > .enu-notice{display:flex}
  .enu-notice-wrap > .enu-notice-mini{display:none}
  .enu-notice-wrap.is-mini > .enu-notice{display:none}
  .enu-notice-wrap.is-mini > .enu-notice-mini{display:inline-flex}
  .enu-notice{font-family:'Quicksand','Arial Rounded MT Bold','Kosugi Maru',sans-serif;border-radius:10px;padding:11px 14px;font-size:.78rem;line-height:1.75;gap:8px;align-items:flex-start;border:1px solid}
  .enu-notice .enu-icon{font-size:.95rem;line-height:1.4;flex-shrink:0}
  .enu-notice .enu-body{flex:1;min-width:0}
  .enu-notice .enu-close-btn{font-family:'Quicksand','Arial Rounded MT Bold','Kosugi Maru',sans-serif;flex-shrink:0;background:transparent;border:none;cursor:pointer;font-size:1rem;line-height:1;padding:4px 6px;margin:-4px -6px -4px 0;opacity:.45;color:inherit;transition:opacity .15s}
  .enu-notice .enu-close-btn:hover{opacity:1}
  .enu-notice-mini{font-family:'Quicksand','Arial Rounded MT Bold','Kosugi Maru',sans-serif;width:30px;height:30px;border-radius:50%;border:1px solid;cursor:pointer;font-size:.85rem;line-height:1;padding:0;align-items:center;justify-content:center;transition:transform .15s,box-shadow .15s}
  .enu-notice-mini:hover{transform:scale(1.08);box-shadow:0 1px 4px rgba(0,0,0,.10)}
  .enu-notice-info,.enu-notice-mini-info{background:#eef4f9;border-color:#c5d8ea;color:#355a7a}
  .enu-notice-disclaim,.enu-notice-mini-disclaim{background:#faecec;border-color:#e8c8c8;color:#804a52}
  .enu-notice-help,.enu-notice-mini-help{background:#eef2ec;border-color:#c8d3c1;color:#4a5d44}
  .enu-notice-help .enu-help-link{font-family:'Quicksand','Arial Rounded MT Bold','Kosugi Maru',sans-serif;color:#344230;text-decoration:underline;text-underline-offset:2px;font-weight:700;font-size:.78rem;margin-left:2px}
  .enu-notice-help .enu-help-link:hover{color:#1f2c1c}

  /* ===== コンテンツカード ===== */
  .card{
    background:var(--card); border:1px solid var(--line); border-radius:14px;
    padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.04); margin:14px 0;
  }
  .screen{ animation:fade .35s ease; }
  @keyframes fade{ from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:none;} }

  /* ===== ボタン ===== */
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:6px;
    border:none; cursor:pointer; font-family:inherit; font-weight:600; font-size:0.95rem;
    border-radius:999px; padding:12px 26px;
    transition:background .18s, color .18s, border-color .18s, filter .18s, transform .08s;
  }
  .btn:active{ transform:scale(.98); }
  .btn-primary{ background:var(--primary-dark); color:#fff; }
  .btn-primary:hover{ filter:brightness(.93); }
  .btn-soft{ background:var(--primary-soft); color:var(--primary-dark); }
  .btn-soft:hover{ background:var(--primary-light); }
  .btn-ghost{
    background:transparent; color:var(--sub); border:1px solid var(--sub); font-weight:600;
    padding:7px 16px; font-size:0.75rem;
  }
  .btn-ghost:hover{ color:var(--primary-dark); border-color:var(--primary-dark); }
  .btn:disabled{ opacity:.45; cursor:not-allowed; }
  .btn-block{ display:flex; width:100%; }

  .mt16{ margin-top:16px; }
  .mt12{ margin-top:12px; }

  /* ===== 進捗 ===== */
  .progress-head{
    display:flex; justify-content:space-between; align-items:baseline;
    font-size:0.78rem; color:var(--sub); margin-bottom:8px; font-weight:600;
  }
  .progress-track{ height:8px; background:var(--primary-light); border-radius:999px; overflow:hidden; }
  .progress-fill{ height:100%; background:var(--primary); border-radius:999px; width:0; transition:width .35s ease; }

  /* ===== 設問 ===== */
  .q-text{ font-size:1.12rem; font-weight:700; margin:18px 0 16px; line-height:1.55; }
  .opt-list{ display:flex; flex-direction:column; gap:10px; }
  .opt{
    text-align:left; width:100%; background:var(--bg-soft);
    border:1.5px solid var(--line); border-radius:12px; padding:14px 16px;
    font-family:inherit; font-size:0.92rem; color:var(--text); cursor:pointer;
    transition:border-color .15s, background .15s; display:flex; align-items:center; gap:12px;
  }
  .opt:hover{ border-color:var(--primary); }
  .opt .dot{ flex:0 0 auto; width:18px; height:18px; border-radius:50%; border:2px solid var(--primary); position:relative; transition:.15s; }
  .opt.selected{ border-color:var(--primary); background:var(--primary-soft); }
  .opt.selected .dot{ background:var(--primary); box-shadow:inset 0 0 0 3px var(--primary-soft); }

  .q-nav{ display:flex; gap:10px; justify-content:space-between; align-items:center; margin-top:20px; }
  .q-foot{ text-align:center; margin-top:14px; }

  /* ===== 結果 ===== */
  .result-card{ text-align:center; background:linear-gradient(160deg, var(--primary-soft), var(--card)); border:1px solid var(--primary-light); }
  .result-emoji{ font-size:2.6rem; line-height:1; }
  .result-label{ font-size:0.76rem; font-weight:600; color:var(--sub); letter-spacing:.1em; margin-top:10px; }
  .result-type{ font-size:1.5rem; font-weight:700; margin:6px 0 14px; color:var(--primary-dark); }
  .result-comment{ font-size:0.94rem; text-align:left; margin:16px 0; }
  .result-howto{ text-align:left; background:var(--bg-soft); border:1px solid var(--line); border-radius:12px; padding:14px 16px; font-size:0.88rem; margin-top:20px; }
  .ht-title{ font-weight:700; font-size:0.82rem; color:var(--primary-dark); margin-bottom:6px; display:flex; align-items:center; gap:6px; }

  /* タイプ別バランス（レーダーチャート） */
  .radar-wrap{ margin:16px 0 2px; }
  .match-caption{ font-size:0.76rem; color:var(--sub); font-weight:600; display:flex; align-items:center; justify-content:center; gap:6px; margin-bottom:4px; }
  .radar-box{ display:flex; justify-content:center; }
  .radar-svg{ width:100%; max-width:300px; height:auto; }
  .radar-data{ transform-box:fill-box; }

  /* 相性チップ */
  .feat-chips{ display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; }
  .feat-chip{ font-size:0.76rem; background:var(--primary-soft); color:var(--primary-dark); border:1px solid var(--primary-light); border-radius:999px; padding:5px 12px; font-weight:600; }

  .ref-note{ font-size:0.74rem; color:var(--sub); margin-top:14px; line-height:1.6; background:var(--bg-soft); border:1px dashed var(--line); border-radius:10px; padding:10px 12px; text-align:left; }
  .result-actions{ margin-top:18px; }

  /* ===== フッター ===== */
  .app-footer{ margin-top:24px; text-align:center; }
  .footer-home{ margin-bottom:12px; }
  .footer-line{ border-top:1px solid color-mix(in srgb, var(--sub) 30%, transparent); margin-bottom:12px; }
  .footer-credit a{ color:var(--sub); text-decoration:none; font-size:0.7rem; font-weight:600; }
  .footer-credit a:hover{ color:var(--primary-dark); }
  .footer-copy{ margin-top:8px; font-size:0.65rem; color:var(--sub); }

  .hidden{ display:none !important; }

  @media (max-width:480px){
    .app-header h1{ font-size:1.25rem; }
    .welcome-title{ font-size:1.5rem; }
    .result-type{ font-size:1.32rem; }
    .btn{ font-size:0.92rem; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ヘッダー（ウェルカムでは非表示・診断/結果で表示） -->
  <header class="app-header hidden" id="appHeader">
    <span class="badge">クレカ診断</span>
    <h1>あなたに合うのはどのタイプ？</h1>
  </header>

  <!-- 注意書きカード（101正規・ウェルカムでは非表示） -->
  <section class="enu-notice-area hidden" id="noticeArea">
    <!-- 🚨 免責（全アプリ共通） -->
    <div class="enu-notice-wrap" data-notice-id="disclaim">
      <div class="enu-notice enu-notice-disclaim">
        <span class="enu-icon">🚨</span>
        <span class="enu-body">この診断は、あなたに合いそうなクレジットカードの「タイプ」の傾向を知るための参考コンテンツです。特定カードの推奨や、お申し込みの勧誘ではありません。実際のカード選び・お申し込みはご自身のご判断で行い、還元率・年会費・特典・キャンペーン・審査条件などの最新内容は、各カード会社の公式情報を必ずご確認ください。</span>
        <button type="button" class="enu-close-btn" aria-label="最小化">×</button>
      </div>
      <button type="button" class="enu-notice-mini enu-notice-mini-disclaim" aria-label="免責事項を表示" title="免責事項を表示">🚨</button>
    </div>
    <!-- 💾 ローカル保存案内（ローカル時のみ） -->
    <div class="enu-notice-wrap" data-notice-id="info" data-storage="local">
      <div class="enu-notice enu-notice-info">
        <span class="enu-icon">💾</span>
        <span class="enu-body">診断結果はこの端末（ブラウザ）内にのみ保存されます。Googleログインなどは不要で、すぐにお使いいただけます。</span>
        <button type="button" class="enu-close-btn" aria-label="最小化">×</button>
      </div>
      <button type="button" class="enu-notice-mini enu-notice-mini-info" aria-label="案内を表示" title="案内を表示">💾</button>
    </div>
    <!-- 📚 ヘルプ導線（全アプリ共通） -->
    <div class="enu-notice-wrap" data-notice-id="help">
      <div class="enu-notice enu-notice-help">
        <span class="enu-icon">📚</span>
        <span class="enu-body">使い方や困ったときは、<a href="" class="enu-help-link" id="enu-help-link">ヘルプページ</a>をご覧ください。</span>
        <button type="button" class="enu-close-btn" aria-label="最小化">×</button>
      </div>
      <button type="button" class="enu-notice-mini enu-notice-mini-help" aria-label="ヘルプを表示" title="ヘルプを表示">📚</button>
    </div>
  </section>

  <!-- メイン -->
  <main id="main"></main>

  <!-- フッター -->
  <footer class="app-footer">
    <div class="footer-home" id="footerHome">
      <a href="https://enu-tools.pages.dev/" class="btn btn-ghost" target="_blank" rel="noopener">🏠 ホームへ戻る</a>
    </div>
    <div class="footer-line"></div>
    <div class="footer-credit">
      <a href="https://enu-tools.pages.dev/" target="_blank" rel="noopener">🌷 by enu(エヌ)</a>
    </div>
    <div class="footer-copy" id="footerCopy"></div>
  </footer>

</div>

<script>
(function(){
  'use strict';

  /* ===== ENU_CONFIG ===== */
  var ENU_CONFIG = {
    appId:          'best-credit-card',
    appName:        'クレカ診断',
    dataVersion:    1,
    storageType:    'local',
    helpUrl:        'https://enu-tools.pages.dev/help/',
    helpOpenNewTab: true
  };
  var CFG = ENU_CONFIG;
  var ICON_EMOJI = '💳';

  /* ===== DOMヘルパー（innerHTML不使用） ===== */
  function el(tag, opts, children){
    var node = document.createElement(tag);
    opts = opts || {};
    if(opts.class) node.className = opts.class;
    if(opts.text != null) node.textContent = opts.text;
    if(opts.attrs){ for(var k in opts.attrs){ node.setAttribute(k, opts.attrs[k]); } }
    if(opts.on){ for(var ev in opts.on){ node.addEventListener(ev, opts.on[ev]); } }
    if(children){ children.forEach(function(c){ if(c) node.appendChild(c); }); }
    return node;
  }
  function _key(suffix){ return 'enu_' + CFG.appId + '_' + suffix; }

  var appHeader = document.getElementById('appHeader');
  var noticeArea = document.getElementById('noticeArea');
  var footerHome = document.getElementById('footerHome');
  var main = document.getElementById('main');

  function showChrome(show){
    if(appHeader)  appHeader.classList.toggle('hidden', !show);
    if(noticeArea) noticeArea.classList.toggle('hidden', !show);
    if(footerHome) footerHome.classList.toggle('hidden', !show); // ウェルカム画面ではホームボタン非表示（001準拠）
  }

  /* ===== SVGヘルパー（innerHTML不使用） ===== */
  var SVGNS = 'http://www.w3.org/2000/svg';
  function svgEl(tag, attrs, children){
    var n = document.createElementNS(SVGNS, tag);
    if(attrs){ for(var k in attrs){ if(attrs[k] != null) n.setAttribute(k, attrs[k]); } }
    if(children){ children.forEach(function(c){ if(c) n.appendChild(c); }); }
    return n;
  }
  function paletteColors(){
    var cs;
    try{ cs = getComputedStyle(document.documentElement); }catch(e){ cs = null; }
    function v(name, fb){ try{ return (cs.getPropertyValue(name) || '').trim() || fb; }catch(e){ return fb; } }
    return {
      primary:     v('--primary', '#C4A85A'),
      primaryDark: v('--primary-dark', '#9A8238'),
      line:        v('--line', '#ede5cc'),
      sub:         v('--sub', '#7A756B')
    };
  }

  /* ===== レーダーチャート（五角形・5タイプのバランス） ===== */
  function buildRadar(result){
    var C = paletteColors();
    var cx = 140, cy = 120, R = 72, labelR = 99;
    var N = TYPE_ORDER.length;

    var maxScore = 0;
    TYPE_ORDER.forEach(function(k){ var v = result.scores[k] || 0; if(v > maxScore) maxScore = v; });

    function pt(i, radius){
      var ang = (-90 + i * (360 / N)) * Math.PI / 180;
      return { x: cx + radius * Math.cos(ang), y: cy + radius * Math.sin(ang) };
    }
    function polyPoints(radiusFn){
      var arr = [];
      for(var i=0;i<N;i++){ var p = radiusFn(i); arr.push(p.x.toFixed(1) + ',' + p.y.toFixed(1)); }
      return arr.join(' ');
    }

    var svg = svgEl('svg', { viewBox:'0 0 280 250', class:'radar-svg', role:'img', 'aria-label':'タイプ別バランスのレーダーチャート' });

    // 背景リング（外周＋中間）
    [1, 0.5].forEach(function(f){
      svg.appendChild(svgEl('polygon', {
        points: polyPoints(function(i){ return pt(i, R * f); }),
        fill:'none', stroke:C.line, 'stroke-width':1
      }));
    });
    // 軸線
    for(var i=0;i<N;i++){
      var v = pt(i, R);
      svg.appendChild(svgEl('line', { x1:cx, y1:cy, x2:v.x.toFixed(1), y2:v.y.toFixed(1), stroke:C.line, 'stroke-width':1 }));
    }

    // データポリゴン＋頂点（アニメ用に <g> でまとめる）
    var dataG = svgEl('g', { class:'radar-data' });
    dataG.appendChild(svgEl('polygon', {
      points: polyPoints(function(i){
        var v = maxScore > 0 ? (result.scores[TYPE_ORDER[i]] || 0) / maxScore : 0;
        return pt(i, R * v);
      }),
      fill:C.primary, 'fill-opacity':0.35, stroke:C.primaryDark, 'stroke-width':2, 'stroke-linejoin':'round'
    }));
    for(var j=0;j<N;j++){
      var vv = maxScore > 0 ? (result.scores[TYPE_ORDER[j]] || 0) / maxScore : 0;
      var dp = pt(j, R * vv);
      var isTop = (TYPE_ORDER[j] === result.winnerKey);
      dataG.appendChild(svgEl('circle', {
        cx:dp.x.toFixed(1), cy:dp.y.toFixed(1), r:isTop ? 4.5 : 3,
        fill:C.primaryDark, stroke:'#fff', 'stroke-width':isTop ? 1.5 : 1
      }));
    }
    svg.appendChild(dataG);

    // ラベル（絵文字＋短縮名）
    for(var m=0;m<N;m++){
      var lp = pt(m, labelR);
      var dx = lp.x - cx;
      var anchor = Math.abs(dx) < 8 ? 'middle' : (dx > 0 ? 'start' : 'end');
      var key = TYPE_ORDER[m];
      var t = svgEl('text', { x:lp.x.toFixed(1), y:lp.y.toFixed(1), 'text-anchor':anchor, 'font-size':12 });
      var em = svgEl('tspan', { x:lp.x.toFixed(1), dy:'-0.1em', 'font-size':14 }); em.textContent = TYPES[key].emoji;
      var nm = svgEl('tspan', { x:lp.x.toFixed(1), dy:'1.15em', 'font-size':10, fill:C.sub, 'font-weight':'600' }); nm.textContent = TYPES[key].short;
      t.appendChild(em); t.appendChild(nm);
      svg.appendChild(t);
    }

    // 出現アニメーション（中心からふわっと）
    dataG.style.transformOrigin = 'center';
    dataG.style.transform = 'scale(0.02)';
    dataG.style.opacity = '0';
    dataG.style.transition = 'transform .55s cubic-bezier(.34,1.4,.5,1), opacity .4s ease';

    var box = el('div', { class:'radar-box' });
    box.appendChild(svg);
    var wrap = el('div', { class:'radar-wrap' }, [
      el('div', { class:'match-caption' }, [ el('span', { text:'📊' }), el('span', { text:'タイプ別バランス' }) ]),
      box
    ]);
    wrap._radarData = dataG; // アニメ発火用に参照を保持
    return wrap;
  }

  /* ===== 結果タイプ（5タイプ・順序＝表示/タイブレーク基準） ===== */
  var TYPE_ORDER = ['save','travel','status','simple','net'];
  var TYPES = {
    save: {
      emoji:'🪙', type:'高還元・節約タイプ', short:'節約',
      comment:'毎日のお買い物やお支払いを、コツコツお得にしたいあなた。派手な特典より「ポイント還元率」や「キャッシュバック」を重視するタイプです。よく使うお店やサービスで還元が高くなるカードと相性が良さそう。',
      howto:'「基本の還元率」「よく行くお店での優待」を軸に選ぶのがおすすめ。普段使いの1枚に集約すると、ポイントもたまりやすくなります。',
      feats:['高めの基本還元率','よく使うお店での上乗せ','ポイントの使いやすさ']
    },
    travel: {
      emoji:'✈️', type:'旅行・マイルタイプ', short:'旅行',
      comment:'旅行や移動が多く、特典で“次の旅”をお得にしたいあなた。ポイントよりマイルや旅行関連の優待に魅力を感じるタイプです。航空会社や旅行サービスと相性の良いカードが候補に。',
      howto:'「マイルの貯まりやすさ」「空港ラウンジ・旅行保険」などの旅行特典を軸に。よく使う航空会社・サービスに合わせると効率的です。',
      feats:['マイル還元','空港ラウンジ・旅行保険','海外での使いやすさ']
    },
    status: {
      emoji:'👑', type:'ステータス・優待タイプ', short:'優待',
      comment:'上質な体験や特別感を大切にしたいあなた。年会費以上の価値を、優待やサービス・ステータスに見いだすタイプです。ゴールド／プラチナ系など、特典が充実したカードが候補に。',
      howto:'「優待・コンシェルジュ・ラウンジ」などの体験価値と、年会費のバランスを軸に。自分が実際に使う特典が多いカードを選ぶと“元が取れ”やすいです。',
      feats:['上質な優待・体験','専用サービス','充実した付帯保険']
    },
    simple: {
      emoji:'🍃', type:'シンプル・年会費無料タイプ', short:'シンプル',
      comment:'余計な機能より「手軽さ」を大事にしたいあなた。年会費無料で、迷わずシンプルに使える1枚が心地よいタイプです。はじめての1枚や、サブの1枚にもぴったり。',
      howto:'「年会費無料」「使い方のわかりやすさ」を軸に。ポイントが自動でつく・管理がラクなど、続けやすさで選ぶと失敗しにくいです。',
      feats:['年会費無料','シンプルな仕組み','申し込みのしやすさ']
    },
    net: {
      emoji:'🛒', type:'ネット・サブスクタイプ', short:'ネット',
      comment:'ネットショッピングやサブスクをよく使うあなた。特定のサービスでの還元や、ネット決済の便利さに魅力を感じるタイプです。よく使うECサイトやサブスクと相性の良いカードが候補に。',
      howto:'「よく使うネットサービスでの還元」「ナンバーレスなどの安心感」を軸に。利用先に特化したカードだと、ポイントが一気にたまりやすいです。',
      feats:['ネットサービスでの高還元','サブスク・定期決済に便利','ネット決済の安心感']
    }
  };

  /* ===== 設問データ（各選択肢が複数タイプに加点） ===== */
  var QUESTIONS = [
    {
      q:'🛍️ 普段、いちばんよく使うお店・支払い先は？',
      opts:[
        { e:'🛒', t:'スーパーやドラッグストアなど、日常の買い物が中心', s:{ save:2, simple:1 } },
        { e:'💻', t:'ネット通販やサブスク（動画・音楽など）が多い',       s:{ net:2, save:1 } },
        { e:'🧳', t:'旅行・交通・出張でよく使う',                         s:{ travel:2, status:1 } },
        { e:'🏬', t:'百貨店・ホテルなど、ちょっと良いお店も使う',         s:{ status:2, travel:1 } }
      ]
    },
    {
      q:'✨ クレジットカードに一番期待することは？',
      opts:[
        { e:'💰', t:'とにかくポイント・キャッシュバックでお得に', s:{ save:2 } },
        { e:'🛫', t:'マイルや旅行の特典をためたい',               s:{ travel:2 } },
        { e:'🛋️', t:'空港ラウンジや上質な優待・体験',             s:{ status:2 } },
        { e:'🍃', t:'余計な機能はいらない、手軽さ重視',           s:{ simple:2 } }
      ]
    },
    {
      q:'💴 年会費についての考えに近いのは？',
      opts:[
        { e:'🆓', t:'絶対に無料がいい',                           s:{ simple:2, save:1 } },
        { e:'🪙', t:'元が取れるなら数千円はOK',                   s:{ save:2 } },
        { e:'🎫', t:'特典が良ければ1万円以上でも検討する',        s:{ travel:1, status:1 } },
        { e:'👑', t:'ステータスや体験のためなら高くても価値を感じる', s:{ status:2 } }
      ]
    },
    {
      q:'✈️ 旅行や出張の頻度は？',
      opts:[
        { e:'🏠', t:'ほとんど行かない',               s:{ save:1, simple:1 } },
        { e:'🗓️', t:'年に1〜2回くらい',               s:{ save:2 } },
        { e:'🧳', t:'年に数回〜定期的に行く',         s:{ travel:2 } },
        { e:'🌍', t:'頻繁に飛行機・ホテルを使う',     s:{ travel:2, status:1 } }
      ]
    },
    {
      q:'🛒 ネットショッピングやサブスクの利用は？',
      opts:[
        { e:'🙅', t:'ほとんど使わない',                         s:{ simple:2 } },
        { e:'🛍️', t:'時々利用する',                             s:{ save:1 } },
        { e:'📦', t:'よく使う（買い物・配送など）',             s:{ net:2 } },
        { e:'🎬', t:'動画・音楽など、サブスクをいくつも契約している', s:{ net:2, save:1 } }
      ]
    },
    {
      q:'📱 スマホ決済（Apple Pay／Google Pay／QRコード）の利用は？',
      opts:[
        { e:'💵', t:'ほとんど使わない／現金やカードで直接決済',     s:{ simple:1 } },
        { e:'☕', t:'コンビニ・カフェなどで時々使う',               s:{ save:1 } },
        { e:'⚡', t:'メイン決済として使う（タッチ／QRが中心）',     s:{ net:3 } },
        { e:'🔀', t:'各種QR・タッチ決済を使い分けている',     s:{ net:2, save:1 } }
      ]
    },
    {
      q:'🎁 ポイントやマイルの「使い方」のイメージは？',
      opts:[
        { e:'💴', t:'普段の支払いに充てて節約したい',           s:{ save:2 } },
        { e:'🎟️', t:'旅行・航空券に交換してお得に旅したい',     s:{ travel:2 } },
        { e:'🛍️', t:'ネットの買い物やギフト券に使いたい',       s:{ net:2 } },
        { e:'🍃', t:'ポイントは気にしない、シンプルに使えれば', s:{ simple:2 } }
      ]
    },
    {
      q:'👑 カードに「特別感」や優待を求めますか？',
      opts:[
        { e:'🔧', t:'特に求めない、実用重視',                 s:{ simple:2, save:1 } },
        { e:'🎀', t:'お得な優待があれば嬉しい',               s:{ save:2 } },
        { e:'🛬', t:'旅行系の優待（ラウンジ等）は欲しい',     s:{ travel:1, status:1 } },
        { e:'👑', t:'ステータスや上質な体験を重視したい',     s:{ status:2 } }
      ]
    }
  ];

  /* ===== スコア計算・結果判定 ===== */
  function emptyScores(){ var o={}; TYPE_ORDER.forEach(function(k){ o[k]=0; }); return o; }

  function scoreFromAnswers(answers){
    var scores = emptyScores();
    for(var i=0;i<QUESTIONS.length;i++){
      var oi = answers[i];
      if(oi == null) continue;
      var s = QUESTIONS[i].opts[oi].s || {};
      for(var k in s){ if(scores.hasOwnProperty(k)) scores[k] += s[k]; }
    }
    return scores;
  }

  function computeResult(scores){
    // 勝ちタイプ：最高得点の中で TYPE_ORDER が先のもの（strict > なので自然に先勝ち）
    var max = 0, winnerKey = TYPE_ORDER[0];
    TYPE_ORDER.forEach(function(k){
      var v = scores[k] || 0;
      if(v > max){ max = v; winnerKey = k; }
    });
    return { winnerKey:winnerKey, winner:TYPES[winnerKey], scores:scores };
  }

  /* ===== 状態 ===== */
  var state = { qIndex:0, answers:new Array(QUESTIONS.length).fill(null) };

  /* ===== localStorage（前回結果） ===== */
  var STORE_KEY = _key('lastResult');
  function saveResult(scores, winnerType){
    try{
      localStorage.setItem(STORE_KEY, JSON.stringify({ scores:scores, type:winnerType, at:new Date().toISOString(), v:CFG.dataVersion }));
    }catch(e){ /* プライベートモード等。動作は継続 */ }
  }
  function loadResult(){
    try{
      var raw = localStorage.getItem(STORE_KEY);
      if(!raw) return null;
      var d = JSON.parse(raw);
      if(!d || typeof d.scores !== 'object' || d.scores === null) return null;
      // 妥当性：少なくとも既知キーが数値で存在
      var ok = false;
      for(var i=0;i<TYPE_ORDER.length;i++){ if(typeof d.scores[TYPE_ORDER[i]] === 'number'){ ok = true; break; } }
      if(!ok) return null;
      return d;
    }catch(e){ return null; }
  }

  function clearMain(){
    while(main.firstChild) main.removeChild(main.firstChild);
    // 画面遷移時、上端から離れていたらスムーススクロールで戻す（次の質問・結果・はじめに戻る、すべてに適用）
    if(typeof window !== 'undefined' && window.scrollY > 0){
      try{ window.scrollTo({ top:0, behavior:'smooth' }); }catch(e){ window.scrollTo(0, 0); }
    }
  }

  /* ===== スタート画面（注意書き・ヘッダー非表示） ===== */
  function renderWelcome(){
    showChrome(false);
    clearMain();

    var screen = el('div', { class:'welcome-screen screen' });
    screen.appendChild(el('div', { class:'welcome-icon' }, [ el('span', { class:'wi-emoji', text:ICON_EMOJI }) ]));
    screen.appendChild(el('div', { class:'welcome-title', text:'クレカ診断' }));
    screen.appendChild(el('div', { class:'welcome-tagline', text:'8つの質問で、あなたに合いそうなクレジットカードの“タイプ”が分かります。' }));

    var card = el('div', { class:'welcome-card' });
    card.appendChild(el('h3', { text:'この診断でできること' }));
    var feats = [
      ['📝', '8問の選択式。1〜2分で完了します'],
      ['💳', 'ざっくりタイプが分かります'],
      ['📊', '5タイプのバランスをチャートで表示します'],
      ['💾', '診断結果はこの端末に保存。前回の結果もすぐ見られます']
    ];
    var ul = el('ul', { class:'welcome-features' });
    feats.forEach(function(f){
      ul.appendChild(el('li', {}, [ el('span', { class:'fi', text:f[0] }), el('span', { text:f[1] }) ]));
    });
    card.appendChild(ul);
    screen.appendChild(card);

    var actions = el('div', { class:'welcome-actions' });
    actions.appendChild(el('button', { class:'btn btn-primary btn-block mt16', text:'診断をはじめる', attrs:{ type:'button' }, on:{ click:startQuiz } }));
    var prev = loadResult();
    if(prev){
      actions.appendChild(el('button', { class:'btn btn-soft btn-block mt12', text:'前回の結果を見る（' + (prev.type || '') + '）', attrs:{ type:'button' }, on:{ click:function(){ showSavedResult(prev); } } }));
    }
    screen.appendChild(actions);
    main.appendChild(screen);
  }

  /* ===== 診断 ===== */
  function startQuiz(){
    state.qIndex = 0;
    state.answers = new Array(QUESTIONS.length).fill(null);
    renderQuestion();
  }

  function renderQuestion(){
    showChrome(true);
    clearMain();
    var idx = state.qIndex;
    var q = QUESTIONS[idx];
    var card = el('div', { class:'card screen' });

    var pct = Math.round(((idx+1)/QUESTIONS.length)*100);
    card.appendChild(el('div', { class:'progress-head' }, [
      el('span', { text:'質問 ' + (idx+1) + ' / ' + QUESTIONS.length }),
      el('span', { text:pct + '%' })
    ]));
    var fill = el('div', { class:'progress-fill' });
    fill.style.width = pct + '%';            // ← 生成時に確定。選択時は触らない（ちらつき防止）
    card.appendChild(el('div', { class:'progress-track' }, [ fill ]));

    // 質問文と aria-label 用に、絵文字と本文を分割（スクリーンリーダーが絵文字名を読み上げないように）
    var qSplitIdx = q.q.indexOf(' ');
    var qEmoji = qSplitIdx >= 0 ? q.q.slice(0, qSplitIdx) : '';
    var qBody  = qSplitIdx >= 0 ? q.q.slice(qSplitIdx + 1) : q.q;
    card.appendChild(el('div', { class:'q-text' }, [
      qEmoji ? el('span', { attrs:{ 'aria-hidden':'true' }, text:qEmoji + ' ' }) : null,
      el('span', { text:qBody })
    ]));

    var optButtons = [];
    var nextBtn;
    function selectAt(oi){
      state.answers[idx] = oi;
      optButtons.forEach(function(b, i){
        var sel = (i === oi);
        b.classList.toggle('selected', sel);
        b.setAttribute('aria-pressed', sel ? 'true' : 'false');
      });
      if(nextBtn) nextBtn.disabled = false;     // ← 再描画せず、その場で更新
    }

    var list = el('div', { class:'opt-list', attrs:{ role:'group', 'aria-label':qBody } });
    q.opts.forEach(function(opt, oi){
      var sel = state.answers[idx] === oi;
      var btn = el('button', {
        class:'opt' + (sel ? ' selected' : ''),
        attrs:{ type:'button', 'aria-pressed': sel ? 'true' : 'false' },
        on:{ click:function(){ selectAt(oi); } }
      }, [
        el('span', { class:'dot' }),
        el('span', {}, [
          opt.e ? el('span', { attrs:{ 'aria-hidden':'true' }, text:opt.e + ' ' }) : null,
          el('span', { text:opt.t })
        ])
      ]);
      optButtons.push(btn);
      list.appendChild(btn);
    });
    card.appendChild(list);

    var backBtn = el('button', { class:'btn btn-ghost', text:'← 戻る', attrs:{ type:'button' }, on:{ click:goBack } });
    if(idx === 0) backBtn.disabled = true;
    var isLast = idx === QUESTIONS.length - 1;
    nextBtn = el('button', { class:'btn btn-primary', text:isLast ? '結果を見る' : '次へ →', attrs:{ type:'button' }, on:{ click:goNext } });
    nextBtn.disabled = state.answers[idx] === null;
    card.appendChild(el('div', { class:'q-nav' }, [ backBtn, nextBtn ]));

    card.appendChild(el('div', { class:'q-foot' }, [
      el('button', { class:'btn btn-ghost', text:'はじめに戻る', attrs:{ type:'button' }, on:{ click:renderWelcome } })
    ]));

    main.appendChild(card);
  }

  function goBack(){ if(state.qIndex > 0){ state.qIndex--; renderQuestion(); } }
  function goNext(){
    if(state.answers[state.qIndex] === null) return;
    if(state.qIndex < QUESTIONS.length - 1){ state.qIndex++; renderQuestion(); }
    else { finishQuiz(); }
  }

  /* ===== 結果 ===== */
  function finishQuiz(){
    var scores = scoreFromAnswers(state.answers);
    var result = computeResult(scores);
    saveResult(scores, result.winner.type);
    renderResult(result, false, null);
  }
  function showSavedResult(prev){
    renderResult(computeResult(prev.scores), true, prev.at);
  }

  function renderResult(result, fromSaved, savedAt){
    showChrome(true);
    clearMain();
    var winner = result.winner;

    var card = el('div', { class:'card result-card screen' });
    card.appendChild(el('div', { class:'result-emoji', text:winner.emoji }));
    card.appendChild(el('div', { class:'result-label', text:'あなたのタイプは' }));
    card.appendChild(el('div', { class:'result-type', text:winner.type }));

    card.appendChild(el('p', { class:'result-comment', text:winner.comment }));

    // タイプ別バランス（レーダーチャート）
    var radar = buildRadar(result);
    card.appendChild(radar);

    // 使い方＋相性チップ
    var feats = el('div', { class:'feat-chips' });
    winner.feats.forEach(function(f){ feats.appendChild(el('span', { class:'feat-chip', text:f })); });
    card.appendChild(el('div', { class:'result-howto' }, [
      el('div', { class:'ht-title' }, [ el('span', { text:'💡' }), el('span', { text:'カード選びのヒント（参考）' }) ]),
      el('div', { text:winner.howto }),
      feats
    ]));

    if(fromSaved && savedAt){
      card.appendChild(el('div', { class:'result-label', text:'前回の診断結果（' + formatDate(savedAt) + '）' }));
    }
    main.appendChild(card);

    // 参考カード（免責の念押し）
    main.appendChild(el('div', { class:'card screen' }, [
      el('div', { class:'ht-title' }, [ el('span', { text:'📌' }), el('span', { text:'カード選びの前に' }) ]),
      el('div', { class:'ref-note', text:
        'このタイプ診断は、カード選びの“方向性”を知るための参考コンテンツで、特定カードの推奨ではありません。'
        + '還元率・年会費・特典・キャンペーン内容は変わることがあり、審査基準や付帯条件もカードごとに異なります。'
        + '実際に申し込む前に、各カード会社の公式サイトで最新の条件を必ずご確認ください。'
      })
    ]));

    main.appendChild(el('div', { class:'result-actions' }, [
      el('button', { class:'btn btn-primary btn-block', text:'もう一度診断する', attrs:{ type:'button' }, on:{ click:startQuiz } }),
      el('button', { class:'btn btn-soft btn-block mt12', text:'はじめに戻る', attrs:{ type:'button' }, on:{ click:renderWelcome } })
    ]));

    requestAnimationFrame(function(){
      var g = radar._radarData;
      if(g){ g.style.transform = 'scale(1)'; g.style.opacity = '1'; }
    });
  }

  function formatDate(iso){
    try{ var d = new Date(iso); return d.getFullYear() + '/' + (d.getMonth()+1) + '/' + d.getDate(); }
    catch(e){ return ''; }
  }

  /* ===== 注意書きカード（101正規JS） ===== */
  function applyStorageType(){
    var type = CFG.storageType || 'local';
    var wraps = document.querySelectorAll('.enu-notice-wrap[data-storage]');
    for(var i=0;i<wraps.length;i++){
      if(wraps[i].getAttribute('data-storage') !== type) wraps[i].style.display = 'none';
    }
  }
  function initNotices(){
    var K = _key('notice_minimized');
    var get = function(){ try{ return JSON.parse(localStorage.getItem(K) || '[]'); }catch(e){ return []; } };
    var set = function(l){ try{ localStorage.setItem(K, JSON.stringify(l)); }catch(e){} };
    var help = document.getElementById('enu-help-link');
    if(help){ help.href = CFG.helpUrl || '#'; if(CFG.helpOpenNewTab !== false){ help.target = '_blank'; help.rel = 'noopener'; } }
    var list = get();
    document.querySelectorAll('.enu-notice-wrap[data-notice-id]').forEach(function(w){
      if(list.indexOf(w.dataset.noticeId) !== -1) w.classList.add('is-mini');
    });
    document.querySelectorAll('.enu-notice-wrap .enu-close-btn').forEach(function(b){
      b.addEventListener('click', function(){
        var w = b.closest('.enu-notice-wrap'), id = w.dataset.noticeId;
        w.classList.add('is-mini');
        var l = get(); if(l.indexOf(id) === -1){ l.push(id); set(l); }
      });
    });
    document.querySelectorAll('.enu-notice-mini').forEach(function(m){
      m.addEventListener('click', function(){
        var w = m.closest('.enu-notice-wrap'), id = w.dataset.noticeId;
        w.classList.remove('is-mini');
        set(get().filter(function(x){ return x !== id; }));
      });
    });
  }

  /* ===== フッターのコピーライト ===== */
  function setupFooter(){
    var copy = document.getElementById('footerCopy');
    if(copy) copy.textContent = '© ' + new Date().getFullYear() + ' enu(エヌ) All rights reserved.';
  }

  /* ===== PWA / アイコン（003準拠：--bg を getComputedStyle で取得） ===== */
  function bgColor(){
    var c = '';
    try{ c = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim(); }catch(e){}
    return c || '#faf7f0';
  }
  function emojiFont(px){ return px + "px 'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji','Twemoji Mozilla',sans-serif"; }
  function roundRectPath(ctx, x, y, w, h, r){
    ctx.beginPath();
    ctx.moveTo(x+r, y);
    ctx.arcTo(x+w, y, x+w, y+h, r);
    ctx.arcTo(x+w, y+h, x, y+h, r);
    ctx.arcTo(x, y+h, x, y, r);
    ctx.arcTo(x, y, x+w, y, r);
    ctx.closePath();
  }
  function makeIcon(size, maskable, bg){
    var c = document.createElement('canvas'); c.width = size; c.height = size;
    var ctx = c.getContext('2d');
    ctx.fillStyle = bg;
    if(maskable){ ctx.fillRect(0, 0, size, size); }            // フルスクエア（角丸なし）
    else { roundRectPath(ctx, 0, 0, size, size, size*0.22); ctx.fill(); } // 角丸22%
    var ratio = maskable ? 0.50 : 0.55;
    ctx.font = emojiFont(size*ratio);
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(ICON_EMOJI, size/2, size/2 + size*0.025);
    return c.toDataURL('image/png');
  }
  function makeFavicon(bg){
    var svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
      + "<rect width='100' height='100' rx='22' fill='" + bg + "'/>"
      + "<text x='50' y='50' font-size='60' text-anchor='middle' dominant-baseline='central' "
      + "font-family='Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji, Twemoji Mozilla, sans-serif'>"
      + ICON_EMOJI + "</text></svg>";
    return 'data:image/svg+xml,' + encodeURIComponent(svg);
  }
  async function setupPWA(){
    try{
      if(document.fonts && document.fonts.ready) await document.fonts.ready;
      var bg = bgColor();
      var path = location.pathname || './';

      var tc = document.querySelector('meta[name="theme-color"]');
      if(!tc){ tc = document.createElement('meta'); tc.name = 'theme-color'; document.head.appendChild(tc); }
      tc.setAttribute('content', bg);

      var fav = document.querySelector('link[rel="icon"]');
      if(!fav){ fav = document.createElement('link'); fav.rel = 'icon'; document.head.appendChild(fav); }
      fav.setAttribute('type', 'image/svg+xml');
      fav.setAttribute('href', makeFavicon(bg));

      var at = document.getElementById('appleTouchIcon');
      if(at) at.setAttribute('href', makeIcon(180, false, bg));

      var icons = await Promise.all([
        Promise.resolve(makeIcon(192, false, bg)),
        Promise.resolve(makeIcon(192, true,  bg)),
        Promise.resolve(makeIcon(512, false, bg)),
        Promise.resolve(makeIcon(512, true,  bg))
      ]);
      var manifest = {
        id: path, name: CFG.appName, short_name: 'クレカ診断',
        start_url: path, scope: path, display: 'standalone', orientation: 'portrait',
        background_color: bg, theme_color: bg,
        icons: [
          { src: icons[0], sizes: '192x192', type: 'image/png', purpose: 'any' },
          { src: icons[1], sizes: '192x192', type: 'image/png', purpose: 'maskable' },
          { src: icons[2], sizes: '512x512', type: 'image/png', purpose: 'any' },
          { src: icons[3], sizes: '512x512', type: 'image/png', purpose: 'maskable' }
        ]
      };
      var mhref = 'data:application/manifest+json,' + encodeURIComponent(JSON.stringify(manifest));
      var ml = document.querySelector('link[rel="manifest"]');
      if(!ml){ ml = document.createElement('link'); ml.rel = 'manifest'; document.head.appendChild(ml); }
      ml.setAttribute('href', mhref);
    }catch(e){ /* PWA設定に失敗してもアプリ本体は動作継続 */ }
  }

  /* ===== 初期化 ===== */
  applyStorageType();
  initNotices();
  setupFooter();
  renderWelcome();
  setupPWA();

})();
</script>
</body>
</html>


